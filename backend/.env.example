APP_ENV=development
DATABASE_URL=sqlite:///./data/civicfix.db
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MEDIA_ROOT=./data/media
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MODEL_WEIGHTS_PATH=./models/best.pt
MODEL_OFFLINE=false
MODEL_ID=keremberke/yolov8n-pothole-segmentation
UPLOAD_MAX_MB=50
VIDEO_MAX_SECONDS=120
VIDEO_FRAME_STRIDE=1
VIDEO_INFERENCE_SIZE=640
IMAGE_INFERENCE_SIZE=960
DUPLICATE_RADIUS_METERS=25
REFERENCE_DAMAGE_COUNT=5
